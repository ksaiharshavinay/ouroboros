# OUROBOROS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- LLM API ---
OPENAI_API_KEY=sk-...
# If using a compatible endpoint (e.g. Azure, local Ollama):
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Swarm settings (optional overrides) ---
# OURO_NUM_AGENTS=500
# OURO_SIM_ROUNDS=30

# --- AutoResearch ---
# OURO_EXPERIMENT_BUDGET_MINUTES=5
# OURO_MAX_EXPERIMENTS=100
